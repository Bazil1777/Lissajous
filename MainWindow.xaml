<Window x:Class="WpfApp1.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:WpfApp1.ViewModels"
        mc:Ignorable="d"
        Title="Фігури Лісажу" Height="680" Width="820"
        Background="#FFFFFF">

    <Window.DataContext>
        <vm:MainViewModel/>
    </Window.DataContext>

    <Grid Margin="12">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="250"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>


        <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto" Margin="0,0,12,0">
            <StackPanel>
                <TextBlock Text="Параметри" FontSize="15" FontWeight="Bold" Margin="0,0,0,10"/>

              
                <TextBlock Text="Ax:" Foreground="#555" FontSize="12"/>
                <TextBox Text="{Binding Ax, UpdateSourceTrigger=PropertyChanged}" Margin="0,2,0,8" Padding="2"/>

          
                <TextBlock Text="Ay:" Foreground="#555" FontSize="12"/>
                <TextBox Text="{Binding Ay, UpdateSourceTrigger=PropertyChanged}" Margin="0,2,0,8" Padding="2"/>

               
                <TextBlock Text="fx (Гц):" Foreground="#555" FontSize="12"/>
                <TextBox Text="{Binding Fx, UpdateSourceTrigger=PropertyChanged}" Margin="0,2,0,8" Padding="2"/>

       
                <TextBlock Text="fy (Гц):" Foreground="#555" FontSize="12"/>
                <TextBox Text="{Binding Fy, UpdateSourceTrigger=PropertyChanged}" Margin="0,2,0,8" Padding="2"/>

              
                <TextBlock Text="Фаза φx (град):" Foreground="#555" FontSize="12"/>
                <Grid Margin="0,2,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="50"/>
                    </Grid.ColumnDefinitions>
                    <Slider Value="{Binding PhiXDeg, UpdateSourceTrigger=PropertyChanged}" Minimum="0" Maximum="360" TickFrequency="15" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <TextBox Grid.Column="1" Text="{Binding PhiXDeg, UpdateSourceTrigger=PropertyChanged}" Padding="2" TextAlignment="Center"/>
                </Grid>


                <TextBlock Text="Фаза φy (град):" Foreground="#555" FontSize="12"/>
                <Grid Margin="0,2,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="50"/>
                    </Grid.ColumnDefinitions>
                    <Slider Value="{Binding PhiYDeg, UpdateSourceTrigger=PropertyChanged}" Minimum="0" Maximum="360" TickFrequency="15" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <TextBox Grid.Column="1" Text="{Binding PhiYDeg, UpdateSourceTrigger=PropertyChanged}" Padding="2" TextAlignment="Center"/>
                </Grid>

         
                <TextBlock Text="Крок (dt):" Foreground="#555" FontSize="12"/>
                <TextBox Text="{Binding TimeStep, UpdateSourceTrigger=PropertyChanged}" Margin="0,2,0,12" Padding="2"/>


                <TextBlock Text="Співвідношення частот:" FontSize="13" FontWeight="Bold" Margin="0,0,0,6"/>
                <UniformGrid Columns="2" Margin="0,0,0,12">
                    <Button Content="1 : 1" Command="{Binding SetRatio11Command}" Margin="2" Padding="4"/>
                    <Button Content="1 : 2" Command="{Binding SetRatio12Command}" Margin="2" Padding="4"/>
                    <Button Content="2 : 3" Command="{Binding SetRatio23Command}" Margin="2" Padding="4"/>
                    <Button Content="3 : 4" Command="{Binding SetRatio34Command}" Margin="2" Padding="4"/>
                </UniformGrid>


                <Button Content="Побудувати" Command="{Binding PlotCommand}" Height="34" FontWeight="Bold" Background="#007ACC" Foreground="White" BorderBrush="{x:Null}"/>
            </StackPanel>
        </ScrollViewer>


        <Border Grid.Column="1" BorderBrush="#E0E0E0" BorderThickness="1" Background="#FAFAFA" CornerRadius="6">
            <Canvas ClipToBounds="True">
                <Polyline Points="{Binding GraphPoints}" 
                          Stroke="#007ACC" 
                          StrokeThickness="2"
                          SnapsToDevicePixels="True"/>
            </Canvas>
        </Border>
    </Grid>
</Window>